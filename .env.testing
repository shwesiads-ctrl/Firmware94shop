APP_NAME="Firmware94shop"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,my

LOG_CHANNEL=single
LOG_LEVEL=debug

# Phase 2.2 isolated testing DB: sqlite in-memory, never a real/customer database.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=f94shop_testing

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6399

MAIL_MAILER=array

# Supplier adapters: mock mode only. No real credentials, no real endpoints.
SUPPLIER_MODE=mock
DHRU_CLASSIC_MODE=mock
GSM_THEME_MODE=mock
FUSION_PRO_MODE=mock
GSMSS_MODE=mock

# Payment: manual review only, never auto-verify.
PAYMENT_AUTO_VERIFY=false
