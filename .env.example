APP_NAME="Firmware94shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,my

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Use mysql for production. sqlite is fine for first boot with zero setup.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=firmware94shop
DB_USERNAME=firmware94shop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=f94shop

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@firmware94shop.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Firmware94shop platform settings (Phase 2 — development-safe defaults)
# ---------------------------------------------------------------------------
F94_CURRENCY=USD
F94_DEFAULT_ADMIN_EMAIL=admin@firmware94shop.test

# Supplier adapters default to the mock drivers until real credentials and
# official documentation are supplied by the project owner. Never set these
# to "live" without real, documented credentials. See docs/SECURITY.md.
F94_SUPPLIER_DHRU_CLASSIC_MODE=mock
F94_SUPPLIER_GSM_THEME_MODE=mock
F94_SUPPLIER_FUSION_PRO_MODE=mock
F94_SUPPLIER_GSMSS_MODE=mock

# Inbound API
F94_API_RATE_LIMIT_PER_MINUTE=60
F94_API_DEFAULT_IP_ALLOWLIST_ENABLED=false

# Payments — wallet addresses are NEVER hardcoded; configure per environment.
F94_PAY_USDT_TRC20_ADDRESS=
F94_PAY_USDT_BEP20_ADDRESS=
F94_PAY_MANUAL_DEPOSIT_ENABLED=true
